# Fake local-only credentials. Replace with an isolated development database.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
CURATOR_EMAILS=curator@example.com
MEDIA_DELIVERY_SIGNING_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://sunstruck_user:change-me@localhost:5432/sunstruck_synapse_dev
# Optional until private review-audio uploads are enabled. Use an R2 token scoped to this bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sunstruck-synapse-media-preview
