{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "worker-configuration.d.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/**/*",
    "tests/**/*",
    "workers/**/*",
    "app/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vite/client"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
