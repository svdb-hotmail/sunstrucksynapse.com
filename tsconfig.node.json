{
  "extends": "./tsconfig.json",
  "include": [
    "react-router.config.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "scripts/**/*",
    "app/config/env.server.ts",
    "app/db/schema/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
