{
  "extends": "./tsconfig.json",
  "include": [
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/**/*",
    "tests/**/*",
    "app/config/env.server.ts",
    "app/db/client.server.ts",
    "app/db/schema/**/*",
    "app/repositories/catalogue.server.ts",
    "app/repositories/curator-fixture.server.ts",
    "app/repositories/curator.server.ts",
    "app/services/access-auth.server.ts",
    "app/services/catalogue.ts",
    "app/services/curator.server.ts",
    "app/services/media-signing.ts",
    "app/services/media.server.ts",
    "app/types/catalogue.ts",
    "app/types/curator.ts",
    "app/utils/json-ld.ts",
    "app/utils/player-storage.ts",
    "app/utils/queue.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vite/client"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
