{
  "extends": "./tsconfig.json",
  "include": [
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/**/*",
    "tests/**/*",
    "app/config/env.server.ts",
    "app/data/catalogue.ts",
    "app/db/schema/**/*",
    "app/types/catalogue.ts",
    "app/utils/queue.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
