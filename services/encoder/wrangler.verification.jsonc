{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sunstruck-synapse-encoder-verification",
  "main": "worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AudioEncoder",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "ENCODERS", "class_name": "AudioEncoder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AudioEncoder"] }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "sunstruck-synapse-media-preview" }],
  "observability": { "enabled": true },
}
