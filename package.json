{
  "name": "sunstruck-synapse-radio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "preview:e2e": "react-router build --mode test && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:validate:local": "node --import tsx scripts/validate-database.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run db:validate:local && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "isbot": "5.1.36",
    "jose": "^6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@electric-sql/pglite": "0.5.5",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.0",
    "@react-router/dev": "8.3.0",
    "@types/node": "22.18.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "postgres": "3.4.9",
    "prettier": "3.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vite": "8.2.1",
    "vitest": "3.2.4",
    "wrangler": "4.123.0"
  }
}
