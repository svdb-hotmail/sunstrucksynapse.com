{
  "name": "sunstruck-synapse-radio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "preview:e2e": "react-router build --mode test && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:encoder": "python3 -m unittest discover -s services/encoder -p 'test_*.py'",
    "test:e2e": "playwright test",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:validate:local": "node --import tsx scripts/validate-database.ts",
    "catalogue:export": "node --env-file-if-exists=.env --import tsx scripts/export-catalogue.ts",
    "catalogue:audit": "node --env-file-if-exists=.env --import tsx scripts/audit-beta-readiness.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:encoder && npm run db:validate:local && npm run build && npm run build-storybook && npm run test:e2e"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@neondatabase/serverless": "1.1.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "image-size": "2.0.4",
    "isbot": "5.1.36",
    "jose": "^6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@electric-sql/pglite": "0.5.5",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "22.18.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "postgres": "3.4.9",
    "prettier": "3.6.2",
    "storybook": "10.6.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "brace-expansion@^5.0.8": "5.0.12"
  }
}
