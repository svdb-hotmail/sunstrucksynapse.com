{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunstruck-synapse-radio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
  // DATABASE_URL is a required secret. Configure it with `wrangler secret put`;
  // Wrangler does not declare plain Worker secret names in this file.
}
