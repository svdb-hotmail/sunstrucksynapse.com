{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunstruck-synapse-radio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://REPLACE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE-ME",
    "CURATOR_EMAILS": "REPLACE-ME@example.com",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sunstruck-synapse-media",
      "preview_bucket_name": "sunstruck-synapse-media-preview",
    },
  ],
  "secrets": {
    "required": ["DATABASE_URL", "MEDIA_DELIVERY_SIGNING_SECRET"],
  },
}
