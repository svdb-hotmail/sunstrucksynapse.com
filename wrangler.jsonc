{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sunstruck-synapse-radio",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "secrets": {
    "required": ["DATABASE_URL"],
  },
}
